{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Provider": "IdentityJwt",
    "Jwt": {
      "Issuer": "ZonarHub",
      "Audience": "ZonarHub",
      "Secret": "dev-secret-change-me-dev-secret-change-me",
      "AccessTokenMinutes": 30,
      "RefreshTokenDays": 7
    }
  },
  "MultiTenancy": {
    "Enabled": true,
    "HeaderName": "X-Tenant-Id"
  },
  "Persistence": {
    "Provider": "Supabase"
  },
  "Supabase": {
    "Url": "",
    "Key": ""
  },
  "Email": {
    "Provider": "Smtp",
    "SuppressDeliveryFailures": false,
    "FromAddress": "noreply@zonarhub.com",
    "FromName": "ZonarHub",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "UseSsl": true,
      "Username": "",
      "Password": ""
    }
  },
  "Security": {
    "GlobalPermitLimit": 300,
    "AnonymousAuthPermitLimit": 20,
    "WindowSeconds": 60,
    "RejectedIpAddresses": []
  }
}
