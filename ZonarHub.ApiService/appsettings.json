{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Provider": "IdentityJwt",
    "Jwt": {
      "Issuer": "ZonarHub",
      "Audience": "ZonarHub",
      "Secret": "dev-secret-change-me-dev-secret-change-me",
      "AccessTokenMinutes": 30,
      "RefreshTokenDays": 7
    }
  },
  "MultiTenancy": {
    "Enabled": true,
    "HeaderName": "X-Tenant-Id"
  },
  "Persistence": {
    "Provider": "InMemory"
  },
  "Supabase": {
    "Url": "",
    "Key": ""
  },
  "Cache": {
    "Provider": "InMemory"
  },
  "Email": {
    "Provider": "InMemory",
    "FromAddress": "noreply@zonarhub.com",
    "FromName": "ZonarHub",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "UseSsl": true,
      "Username": "",
      "Password": ""
    }
  },
  "ExternalServices": {
    "ExchangeRate": {
      "BaseUrl": "https://api.exchangerate.host/"
    }
  }
}
