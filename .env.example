# Local API environment for Development runs.
# Copy this file to .env at the repository root (next to ZonarHub.slnx) and fill in the values locally.
# .env is gitignored; never commit real values. The API loads it only when ASPNETCORE_ENVIRONMENT
# (or DOTNET_ENVIRONMENT) is Development, and never overrides variables already set in the process.
# Format: KEY=VALUE, one per line; comments on their own line; "__" separates configuration sections.
# Empty values are ignored, so the tracked appsettings defaults apply.

# Required. Supabase server-side secret key (sb_secret_...). See docs/supabase-api-key-rotation.md.
Supabase__Key=

# Supabase project URL. Development already has it in appsettings.Development.json; set it only to point elsewhere.
Supabase__Url=

# Extra allowed CORS origins (absolute http/https origin, e.g. https://app.example.com).
# Development already allows the local Angular origins on port 4200; add more with __1, __2, ...
Cors__AllowedOrigins__0=

# appsettings.json ships a development-only JWT signing secret; any shared or hosted environment must set its own.
Authentication__Jwt__Secret=

# Development-only sign-up verification bypass: when set, this code passes email verification without a sent code.
# Honoured only when the environment is Development; ignored everywhere else. Leave empty to disable it.
Authentication__DevelopmentMasterCode=
